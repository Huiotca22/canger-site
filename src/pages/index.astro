---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Disk from '../components/Disk.astro';
import Loaders from '../components/Loaders.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="canger — лаунчер Minecraft, где у каждой версии своя папка с модами"
  description="canger — настольный лаунчер Minecraft на Tauri 2 и Rust. Vanilla, Fabric, Forge и NeoForge из официальных источников, Java подбирается автоматически, у каждой версии своя папка с модами, мирами и настройками. Windows x64."
>
  <Header />
  <main id="main">
    <Hero />
    <Problem />
    <Disk />
    <Loaders />
    <Download />
    <Faq />
  </main>
  <Footer />
</Base>

<script>
  const targets = document.querySelectorAll<HTMLElement>(
    '.facts > div, .term li, .loader-list li, [data-reveal]'
  );

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.12 }
    );

    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  main {
    display: block;
  }
</style>
